[Unit]
Description=Inventory Next.js web
After=network.target
ConditionPathExists=/var/www/inventory-deploy/web/current/server.js

[Service]
Type=simple
User=deploy
Group=www-data
WorkingDirectory=/var/www/inventory-deploy/web/current
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
